# Neon Postgres connection string (Vercel injects it from the adhorarium-db store)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth.js v5
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Comma-separated emails that get the admin role when they sign in
ADMIN_EMAILS=franutn23@gmail.com,franciscoperezdeveloper@gmail.com

# Schedule assistant: Vercel AI Gateway model id (required by /api/assistant, no default)
SCHEDULE_ASSISTANT_MODEL=openai/gpt-4.1-mini
# Local development only; on Vercel the OIDC token authenticates AI Gateway requests
AI_GATEWAY_API_KEY=

# Transactional email (Brevo). Without both values emails are not sent and the server logs "Envío de email no configurado".
BREVO_API_KEY=
MAIL_FROM=AdHorarium <no-reply@adhorarium.app>
# Local runs and e2e only: store emails in the mail_outbox table instead of sending them (ignored in production)
MAIL_OUTBOX=
